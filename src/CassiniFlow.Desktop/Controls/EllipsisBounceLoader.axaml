<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             x:Class="CassiniFlow.Desktop.Controls.EllipsisBounceLoader"
             x:DataType="controls:EllipsisBounceLoader"
             Height="20"
             ClipToBounds="False">

    <UserControl.Styles>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="{Binding DotSize, RelativeSource={RelativeSource AncestorType=controls:EllipsisBounceLoader}}"/>
            <Setter Property="Height" Value="{Binding DotSize, RelativeSource={RelativeSource AncestorType=controls:EllipsisBounceLoader}}"/>
            <Setter Property="Fill" Value="{Binding DotBrush, RelativeSource={RelativeSource AncestorType=controls:EllipsisBounceLoader}, FallbackValue={DynamicResource AppAccent}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform">
                <TranslateTransform Y="0"/>
            </Setter>
        </Style>

        <Style Selector="Ellipse.dot1">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="14%">
                        <Setter Property="TranslateTransform.Y" Value="-6"/>
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="28%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.dot2">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="14%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="28%">
                        <Setter Property="TranslateTransform.Y" Value="-6"/>
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="42%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.dot3">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="28%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="42%">
                        <Setter Property="TranslateTransform.Y" Value="-6"/>
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="56%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.dot4">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="42%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="56%">
                        <Setter Property="TranslateTransform.Y" Value="-6"/>
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="70%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
        <Ellipse Classes="dot dot1"/>
        <Ellipse Classes="dot dot2"/>
        <Ellipse Classes="dot dot3"/>
        <Ellipse Classes="dot dot4"/>
    </StackPanel>
</UserControl>
