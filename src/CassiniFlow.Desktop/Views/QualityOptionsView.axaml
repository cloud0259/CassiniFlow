<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.QualityOptionsView"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Spacing="10" Margin="2,4,2,2">
        <Border Classes="groupbox" Padding="10,8">
            <StackPanel Spacing="8">
                <CheckBox Content="{loc:Tr QualityOptions.EnableQuality}" IsChecked="{Binding EnableQuality}" FontWeight="SemiBold" FontSize="13"/>

                <StackPanel Spacing="8" IsEnabled="{Binding EnableQuality}">
                    <!-- Algorithme de netteté -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Tr QualityOptions.SharpnessAlgo}" Classes="label"/>
                        <ComboBox SelectedIndex="{Binding SelectedQualityAlgoIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{loc:Tr QualityOptions.AlgoDefault}"/>
                            <ComboBoxItem Content="{loc:Tr QualityOptions.AlgoNinox}"/>
                            <ComboBoxItem Content="{loc:Tr QualityOptions.AlgoPeak}"/>
                            <ComboBoxItem Content="{loc:Tr QualityOptions.AlgoTotal}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Options de réordonnancement -->
                    <CheckBox Content="{loc:Tr QualityOptions.ReorderFrames}" IsChecked="{Binding ReorderByQuality}" IsEnabled="{Binding !IsJoinMode}" FontSize="12" ToolTip.Tip="{loc:Tr QualityOptions.ReorderFramesTip}"/>
                    <CheckBox Content="{loc:Tr QualityOptions.QualityWeighting}" IsChecked="{Binding EnableQualityWeighting}" FontSize="12"/>

                    <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,2"/>

                    <!-- Limitation aux meilleures trames -->
                    <CheckBox Content="{loc:Tr QualityOptions.LimitBestFrames}" IsChecked="{Binding LimitQualityFrames}" FontSize="12"/>
                    <Grid ColumnDefinitions="*,8,*" IsEnabled="{Binding LimitQualityFrames}">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{loc:Tr QualityOptions.LimitingMode}" Classes="label"/>
                            <ComboBox SelectedIndex="{Binding SelectedQualityLimitModeIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{loc:Tr QualityOptions.LimitFixed}"/>
                                <ComboBoxItem Content="{loc:Tr QualityOptions.LimitPercent}"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="{loc:Tr QualityOptions.ValueToKeep}" Classes="label"/>
                            <controls:NumberStepper Value="{Binding QualityKeepValue}" Minimum="1" Maximum="999999" FormatString="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
