<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
        xmlns:views="using:CassiniFlow.Desktop.Views"
        xmlns:controls="using:CassiniFlow.Desktop.Controls"
        xmlns:loc="using:CassiniFlow.Desktop.Localization"
        x:Class="CassiniFlow.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr App.Title}"
        Width="1340" Height="820"
        MinWidth="1040" MinHeight="620"
        Background="{DynamicResource AppWindowBackground}"
        Foreground="{DynamicResource AppTextPrimary}"
        Icon="/Assets/cassiniflow.ico"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- BARRE DE MENU ET D'ACTIONS (STYLE CassiniFlow CLASSIQUE MODERNISÉ) -->
        <Border Grid.Row="0" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu Grid.Column="0" VerticalAlignment="Center" IsEnabled="{Binding !IsProcessing}">
                    <MenuItem Header="{loc:Tr Menu.File}">
                        <MenuItem Header="{loc:Tr Menu.AddFiles}" Click="OnAddVideoFilesClick" IsEnabled="{Binding CanAddFiles}"/>
                        <MenuItem Header="{loc:Tr Menu.RemoveSelected}" Command="{Binding RemoveSelectedFileCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.ClearAll}" Command="{Binding ClearAllFilesCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Menu.SelectOutputFolder}" Click="OnSelectOutputFolderClick"/>
                        <MenuItem Header="{loc:Tr Menu.OpenOutputFolder}" Command="{Binding OpenOutputFolderCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Menu.Exit}" Click="OnExitClick"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Preview}">
                        <MenuItem Header="{loc:Tr Menu.FirstFrame}" Command="{Binding FirstFrameCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.LastFrame}" Command="{Binding LastFrameCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Processing}">
                        <MenuItem Header="{loc:Tr Menu.StartProcessing}" Command="{Binding RunProcessingCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.CancelProcessing}" Command="{Binding CancelProcessingCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Settings}">
                        <MenuItem Header="{loc:Tr Menu.OpenSettings}" Click="OnOpenSettingsClick" InputGesture="Ctrl+,"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Menu.Theme}">
                            <MenuItem x:Name="DarkThemeMenuItem" Header="{loc:Tr Menu.ThemeDark}" ToggleType="Radio" GroupName="AppTheme" Click="OnSetThemeDarkClick"/>
                            <MenuItem x:Name="LightThemeMenuItem" Header="{loc:Tr Menu.ThemeLight}" ToggleType="Radio" GroupName="AppTheme" Click="OnSetThemeLightClick"/>
                            <MenuItem x:Name="NightVisionMenuItem" Header="{loc:Tr Menu.ThemeNightVision}" ToggleType="Radio" GroupName="AppTheme" Click="OnSetThemeNightVisionClick"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Tr Menu.Language}">
                            <MenuItem x:Name="FrenchMenuItem" Header="Français" ToggleType="Radio" GroupName="AppLanguage" Click="OnSetLanguageFrenchClick"/>
                            <MenuItem x:Name="EnglishMenuItem" Header="English" ToggleType="Radio" GroupName="AppLanguage" Click="OnSetLanguageEnglishClick"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Help}">
                        <MenuItem Header="{loc:Tr Menu.Tutorial}" Command="{Binding StartTutorialCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.About}" Click="OnAboutClick"/>
                    </MenuItem>
                </Menu>

                <!-- SELECTEUR DE MODE DE TRAITEMENT (SOBRE, SANS ICONES) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource AppPanelSubtleBackground}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="2"
                        IsEnabled="{Binding !IsProcessing}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Content="{loc:Tr Workflow.PreProcessingOnly}"
                                     IsChecked="{Binding IsWorkflowPreProcessingOnly}"
                                     Command="{Binding SetWorkflowModeCommand}"
                                     CommandParameter="prep"
                                     GroupName="WorkflowModeGroup"
                                     Classes="segment-button"
                                     ToolTip.Tip="{loc:Tr Workflow.PreProcessingOnlyTip}"/>
                        <RadioButton Content="{loc:Tr Workflow.StackingOnly}"
                                     IsChecked="{Binding IsWorkflowStackingOnly}"
                                     Command="{Binding SetWorkflowModeCommand}"
                                     CommandParameter="stackingonly"
                                     GroupName="WorkflowModeGroup"
                                     Classes="segment-button"
                                     ToolTip.Tip="{loc:Tr Workflow.StackingOnlyTip}"/>
                        <RadioButton Content="{loc:Tr Workflow.DirectStreamAllInOne}"
                                     IsChecked="{Binding IsWorkflowDirectStreamAllInOne}"
                                     Command="{Binding SetWorkflowModeCommand}"
                                     CommandParameter="directstream"
                                     GroupName="WorkflowModeGroup"
                                     Classes="segment-button"
                                     ToolTip.Tip="{loc:Tr Workflow.DirectStreamAllInOneTip}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{loc:Tr Toolbar.AddSourceFiles}" Click="OnAddVideoFilesClick" IsEnabled="{Binding CanAddFiles}" FontSize="12" Padding="10,5"/>
                    
                    <!-- Bouton Lancer le traitement (quand inactif) -->
                    <Button Content="{loc:Tr Toolbar.StartProcessing}" Command="{Binding RunProcessingCommand}" IsVisible="{Binding !IsProcessing}" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14,5"/>

                    <!-- Bouton avec loader linéaire Ellipsis Bounce (quand actif) -->
                    <Button IsVisible="{Binding IsProcessing}" IsEnabled="False" Background="{DynamicResource AppAccent}" Foreground="White" Padding="16,6" ToolTip.Tip="{loc:Tr Toolbar.ProcessingInProgress}" MinWidth="90" HorizontalContentAlignment="Center">
                        <controls:EllipsisBounceLoader DotBrush="White" DotSize="6"/>
                    </Button>

                    <!-- Bouton Annuler le traitement en cours (style sobre) -->
                    <Button Content="{loc:Tr Toolbar.CancelProcessing}" Command="{Binding CancelProcessingCommand}" IsVisible="{Binding IsProcessing}" Classes="secondary-cancel" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ZONE PRINCIPALE : 3 VOLETS VERTICAUX CONTINUS ET SANS ESPACES VIDES -->
        <Grid Grid.Row="1" ColumnDefinitions="26*,Auto,48*,Auto,26*">

            <!-- VOLET GAUCHE : SESSION & FICHIERS SOURCES -->
            <Border Grid.Column="0" MinWidth="250" MaxWidth="480" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="4" IsEnabled="{Binding !IsProcessing}">
                <views:SourceFilesView />
            </Border>

            <!-- SPLITTER GAUCHE / CENTRE (Fin 2px continu) -->
            <GridSplitter Grid.Column="1" Width="2" Background="{DynamicResource AppBorderBrush}" ResizeDirection="Columns" />

            <!-- VOLET CENTRAL : VIEWER PLANÉTAIRE & NAVIGATION HAUTE RÉSOLUTION -->
            <Border Grid.Column="2" MinWidth="360" Background="{DynamicResource AppWindowBackground}" Padding="4" IsEnabled="{Binding !IsProcessing}">
                <Grid>
                    <views:FrameViewerView />

                    <!-- Carte Didacticiel Interactif Flottante Positionnée Dynamiquement -->
                    <Border IsVisible="{Binding IsTutorialActive}"
                            HorizontalAlignment="{Binding TutorialHorizontalAlignment}"
                            VerticalAlignment="{Binding TutorialVerticalAlignment}"
                            Margin="{Binding TutorialMargin}"
                            Width="390"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppAccent}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="14,12"
                            ZIndex="500">
                        <StackPanel Spacing="8">
                            <!-- En-tête : Badge Étape + Cible + Bouton Quitter -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Border Background="{DynamicResource AppAccent}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding TutorialStepBadge}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding TutorialTargetBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppBadgeFormat}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:Tr Tutorial.Quit}" Command="{Binding CloseTutorialCommand}" FontSize="11" Padding="6,2" Background="Transparent" Foreground="{DynamicResource AppTextDimmed}" ToolTip.Tip="{loc:Tr Tutorial.Quit}"/>
                            </Grid>

                            <TextBlock Text="{Binding TutorialStepTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppText}" Margin="0,2,0,0"/>

                            <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,2"/>

                            <!-- Corps : Explication concise -->
                            <TextBlock Text="{Binding TutorialStepDescription}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{DynamicResource AppTextSecondary}"/>

                            <!-- Pied : Précédent & Suivant -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                <Button Grid.Column="0" Content="{loc:Tr Tutorial.Previous}" Command="{Binding PreviousTutorialStepCommand}" IsEnabled="{Binding CanTutorialGoPrevious}" FontSize="11" Padding="10,4"/>
                                <Button Grid.Column="2" Content="{Binding TutorialNextButtonText}" Command="{Binding NextTutorialStepCommand}" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" FontSize="11" Padding="12,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER CENTRE / DROITE (Fin 2px continu) -->
            <GridSplitter Grid.Column="3" Width="2" Background="{DynamicResource AppBorderBrush}" ResizeDirection="Columns" />

            <!-- VOLET DROIT : PIPELINE EN CARTES ACCORDÉON -->
            <Border Grid.Column="4" MinWidth="290" MaxWidth="520" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6" Margin="2,2,4,4">

                        <!-- CARTE 1 : MODE DE TRAITEMENT & PRESETS (PIPP) -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection1Expanded}" IsVisible="{Binding IsSection1Visible}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section1BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.ModePresets}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="10,8">
                                <StackPanel Spacing="10">
                                    <!-- Mode de traitement -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr SourceFiles.ModeTitle}" Classes="label" FontWeight="SemiBold"/>
                                        <RadioButton Content="{loc:Tr SourceFiles.BatchMode}" IsChecked="{Binding IsBatchMode}" FontSize="12" Margin="0,2"/>
                                        <RadioButton Content="{loc:Tr SourceFiles.JoinMode}" IsChecked="{Binding IsJoinMode}" FontSize="12" Margin="0,2"/>
                                    </StackPanel>

                                    <Separator Background="{DynamicResource AppBorderBrush}"/>

                                    <!-- Presets d'optimisation -->
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:Tr SourceFiles.PresetsTitle}" Classes="label" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Command="{Binding AutoDetectPresetCommand}" Classes="action" ToolTip.Tip="{loc:Tr SourceFiles.AutoDetectPresetTooltip}" Padding="6,2" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ Auto"/>
                                            </Button>
                                        </Grid>
                                        <ComboBox SelectedIndex="{Binding SelectedPresetIndex}" HorizontalAlignment="Stretch" FontSize="12">
                                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetManual}"/>
                                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetPlanetary}"/>
                                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetSolarLunarCloseup}"/>
                                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetSolarLunarFullDisc}"/>
                                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetIss}"/>
                                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetPlanetaryAnimation}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Separator Background="{DynamicResource AppBorderBrush}"/>

                                    <!-- Plage de trames avec labels au-dessus sans chevauchement -->
                                    <StackPanel Spacing="6">
                                        <CheckBox Content="{loc:Tr SourceFiles.LimitRange}" IsChecked="{Binding LimitFrameRange}" FontSize="12"/>
                                        <Grid ColumnDefinitions="*,8,*" IsEnabled="{Binding LimitFrameRange}" Margin="2,0,0,0">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Text="{loc:Tr SourceFiles.Start}" Classes="label"/>
                                                <controls:NumberStepper Value="{Binding StartFrame}" Minimum="1" Maximum="999999" FormatString="0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Text="{loc:Tr SourceFiles.End}" Classes="label"/>
                                                <controls:NumberStepper Value="{Binding EndFrame}" Minimum="1" Maximum="999999" FormatString="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- CARTE 2 : CALIBRATION & ENTRÉE -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection2Expanded}" IsVisible="{Binding IsSection2Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section2BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.InputOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:InputOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 3 : STABILISATION & CENTRAGE -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection3Expanded}" IsVisible="{Binding IsSection3Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section3BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.ProcessingOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:ProcessingOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 4 : TRI QUALITÉ SEEING -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection4Expanded}" IsVisible="{Binding IsSection4Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section4BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.QualityOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:QualityOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 5 : STABILISATION & RÉFÉRENCE (AUTOSTAKKERT) -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection5Expanded}" IsVisible="{Binding IsSection5Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section5BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.StackingRefOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="6,8">
                                <views:StackingReferenceOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 6 : POINTS D'ALIGNEMENT -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection6Expanded}" IsVisible="{Binding IsSection6Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section6BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.AlignmentOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:AlignmentOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 7 : EMPILEMENT MULTI-ZONES & RENDU -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection7Expanded}" IsVisible="{Binding IsSection7Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section7BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.StackingOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:StackingOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 8 : ANIMATION -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection8Expanded}" IsVisible="{Binding IsSection8Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section8BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.AnimationOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:AnimationOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 9 : EXPORT & SORTIE -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection9Expanded}" IsVisible="{Binding IsSection9Visible}" IsEnabled="{Binding !IsProcessing}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section9BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.OutputOptions}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:OutputOptionsView />
                            </Border>
                        </Expander>

                        <!-- CARTE 10 : EXÉCUTION & CONSOLE -->
                        <Expander Classes="accordion-card" IsExpanded="{Binding IsSection10Expanded}" IsVisible="{Binding IsSection10Visible}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Section10BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Tab.DoProcessing}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <Border Padding="4,6">
                                <views:DoProcessingView />
                            </Border>
                        </Expander>
                        </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- BARRE D'ÉTAT INFÉRIEURE (STYLE CassiniFlow) -->
        <Border Grid.Row="2" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ViewerStatusText}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding GlobalStatusText}" FontSize="12" Foreground="{DynamicResource AppBadgeFormat}" Margin="16,0,12,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="ThemeQuickToggleButton" Content="🌙" Click="OnToggleThemeClick" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="13" ToolTip.Tip="{loc:Tr Menu.ThemeToggleTip}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
