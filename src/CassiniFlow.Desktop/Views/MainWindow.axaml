<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
        xmlns:views="using:CassiniFlow.Desktop.Views"
        xmlns:loc="using:CassiniFlow.Desktop.Localization"
        x:Class="CassiniFlow.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr App.Title}"
        Width="1340" Height="820"
        MinWidth="1040" MinHeight="620"
        Background="{DynamicResource AppWindowBackground}"
        Foreground="{DynamicResource AppTextPrimary}"
        Icon="/Assets/cassiniflow.ico"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- BARRE DE MENU ET D'ACTIONS (STYLE CassiniFlow CLASSIQUE MODERNISÉ) -->
        <Border Grid.Row="0" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu Grid.Column="0" VerticalAlignment="Center">
                    <MenuItem Header="{loc:Tr Menu.File}">
                        <MenuItem Header="{loc:Tr Menu.AddFiles}" Click="OnAddVideoFilesClick"/>
                        <MenuItem Header="{loc:Tr Menu.RemoveSelected}" Command="{Binding RemoveSelectedFileCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.ClearAll}" Command="{Binding ClearAllFilesCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Menu.SelectOutputFolder}" Click="OnSelectOutputFolderClick"/>
                        <MenuItem Header="{loc:Tr Menu.OpenOutputFolder}" Command="{Binding OpenOutputFolderCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Menu.Exit}" Click="OnExitClick"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Preview}">
                        <MenuItem Header="{loc:Tr Menu.FirstFrame}" Command="{Binding FirstFrameCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.LastFrame}" Command="{Binding LastFrameCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Processing}">
                        <MenuItem Header="{loc:Tr Menu.StartProcessing}" Command="{Binding RunProcessingCommand}"/>
                        <MenuItem Header="{loc:Tr Menu.CancelProcessing}" Command="{Binding CancelProcessingCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Settings}">
                        <MenuItem Header="{loc:Tr Menu.OpenSettings}" Click="OnOpenSettingsClick" InputGesture="Ctrl+,"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr Menu.Theme}">
                            <MenuItem x:Name="DarkThemeMenuItem" Header="{loc:Tr Menu.ThemeDark}" ToggleType="Radio" GroupName="AppTheme" Click="OnSetThemeDarkClick"/>
                            <MenuItem x:Name="LightThemeMenuItem" Header="{loc:Tr Menu.ThemeLight}" ToggleType="Radio" GroupName="AppTheme" Click="OnSetThemeLightClick"/>
                            <MenuItem x:Name="NightVisionMenuItem" Header="{loc:Tr Menu.ThemeNightVision}" ToggleType="Radio" GroupName="AppTheme" Click="OnSetThemeNightVisionClick"/>
                        </MenuItem>
                        <MenuItem Header="{loc:Tr Menu.Language}">
                            <MenuItem x:Name="FrenchMenuItem" Header="Français" ToggleType="Radio" GroupName="AppLanguage" Click="OnSetLanguageFrenchClick"/>
                            <MenuItem x:Name="EnglishMenuItem" Header="English" ToggleType="Radio" GroupName="AppLanguage" Click="OnSetLanguageEnglishClick"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Menu.Help}">
                        <MenuItem Header="{loc:Tr Menu.About}" Click="OnAboutClick"/>
                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{loc:Tr Toolbar.AddSourceFiles}" Click="OnAddVideoFilesClick" FontSize="12" Padding="10,5"/>
                    <Button Content="{loc:Tr Toolbar.StartProcessing}" Command="{Binding RunProcessingCommand}" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ZONE PRINCIPALE : LES ONGLETS MODULAIRES À GAUCHE / APERÇU DE LA FRAME À DROITE -->
        <Grid Grid.Row="1" ColumnDefinitions="58*,Auto,42*">

            <!-- PANNEAU GAUCHE : LES ONGLETS -->
            <Border Grid.Column="0" MinWidth="480" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="8">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- Utilisation d'un WrapPanel pour empêcher le débordement horizontal des onglets quand la fenêtre est réduite -->
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>

                    <!-- ONGLET 1 : SOURCE FILES -->
                    <TabItem Header="{loc:Tr Tab.SourceFiles}">
                        <views:SourceFilesView />
                    </TabItem>

                    <!-- ONGLET 2 : INPUT OPTIONS -->
                    <TabItem Header="{loc:Tr Tab.InputOptions}">
                        <views:InputOptionsView />
                    </TabItem>

                    <!-- ONGLET 3 : PROCESSING OPTIONS -->
                    <TabItem Header="{loc:Tr Tab.ProcessingOptions}">
                        <views:ProcessingOptionsView />
                    </TabItem>

                    <!-- ONGLET 4 : QUALITY OPTIONS -->
                    <TabItem Header="{loc:Tr Tab.QualityOptions}">
                        <views:QualityOptionsView />
                    </TabItem>

                    <!-- ONGLET 5 : ANIMATION OPTIONS -->
                    <TabItem Header="{loc:Tr Tab.AnimationOptions}">
                        <views:AnimationOptionsView />
                    </TabItem>

                    <!-- ONGLET 6 : OUTPUT OPTIONS -->
                    <TabItem Header="{loc:Tr Tab.OutputOptions}">
                        <views:OutputOptionsView />
                    </TabItem>

                    <!-- ONGLET 7 : DO PROCESSING -->
                    <TabItem Header="{loc:Tr Tab.DoProcessing}">
                        <views:DoProcessingView />
                    </TabItem>

                </TabControl>
            </Border>

            <!-- SPLITTER DE REDIMENSIONNEMENT DES VOLETS -->
            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns" />

            <!-- PANNEAU DROIT : FENÊTRE D'APERÇU CassiniFlow (OUTPUT FRAME VIEWER) -->
            <Border Grid.Column="2" MinWidth="380" Background="{DynamicResource AppWindowBackground}" Padding="10">
                <views:FrameViewerView />
            </Border>

        </Grid>

        <!-- BARRE D'ÉTAT INFÉRIEURE (STYLE CassiniFlow) -->
        <Border Grid.Row="2" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ViewerStatusText}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ProcessingStageText}" FontSize="12" Foreground="{DynamicResource AppBadgeFormat}" Margin="16,0,12,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="ThemeQuickToggleButton" Content="🌙" Click="OnToggleThemeClick" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="13" ToolTip.Tip="{loc:Tr Menu.ThemeToggleTip}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
