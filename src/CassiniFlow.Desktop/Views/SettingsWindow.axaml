<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
        xmlns:loc="using:CassiniFlow.Desktop.Localization"
        x:Class="CassiniFlow.Desktop.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr Settings.WindowTitle}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/cassiniflow.ico"
        Background="{DynamicResource AppWindowBackground}"
        Foreground="{DynamicResource AppTextPrimary}">

    <Border Padding="20,18" Background="{DynamicResource AppPanelBackground}" Margin="10" CornerRadius="10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="14" HorizontalAlignment="Stretch">

            <!-- En-tête : Titre & Description -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                <Image Grid.Column="0" Source="/Assets/icon_256x256.png" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Settings.CpuGroupTitle}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Tr Settings.CpuGroupDesc}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Callout d'avertissement moderne et discret lorsque l'allocation dépasse le seuil -->
            <Border Background="{DynamicResource AppPanelSubtleBackground}"
                    BorderBrush="#f59e0b"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    IsVisible="{Binding IsCpuWarningActive}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Background="#f59e0b"
                            CornerRadius="13"
                            Width="26" Height="26"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="⚠"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#18181b"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CpuWarningTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#f59e0b"/>
                        <TextBlock Text="{Binding CpuWarningMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card des réglages de curseurs CPU -->
            <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="12">

                    <!-- Ligne 1 : Plafond CPU alloué -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings.MaxCpuLabel}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource AppBadgeBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding ActiveCpuThreadsBadge}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppBadgeFormat}"/>
                            </Border>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" Value="{Binding MaxCpuUsagePercent}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="10 %" FontSize="10" Foreground="{DynamicResource AppTextDimmed}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveCpuThreadsText}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="100 %" FontSize="10" Foreground="{DynamicResource AppTextDimmed}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Séparateur discret -->
                    <Rectangle Height="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,2"/>

                    <!-- Ligne 2 : Seuil d'avertissement -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings.WarningThresholdLabel}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource AppBadgeBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding CpuWarningThresholdPercent, StringFormat='{}Seuil: {0} %'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            </Border>
                        </Grid>
                        <Slider Minimum="50" Maximum="95" Value="{Binding CpuWarningThresholdPercent}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{loc:Tr Settings.WarningThresholdDesc}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Résumé matériel et note de sauvegarde automatique -->
            <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TotalCoresDetectedText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppBadgeAccent}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Tr Settings.CpuInfoBox}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Tr Settings.AutoSaveNote}" FontSize="11" Foreground="{DynamicResource AppStatusSuccess}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Pied de fenêtre avec bouton Fermer -->
            <Grid Margin="0,4,0,0">
                <Button Content="{loc:Tr Settings.Close}"
                        Click="OnCloseClick"
                        HorizontalAlignment="Right"
                        Padding="24,6"
                        Background="{DynamicResource AppAccent}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="12"
                        CornerRadius="6"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
