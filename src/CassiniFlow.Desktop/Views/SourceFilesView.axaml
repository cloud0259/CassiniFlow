<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.SourceFilesView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="2,2,2,2">

        <!-- Barre d'outils structurée en 2 rangées professionnelles -->
        <Border Grid.Row="0" Classes="groupbox" Padding="6,5" Margin="0,0,0,4">
            <StackPanel Spacing="5">
                <!-- Rangée 1 : Actions principales (Ajouter & Mesurer) -->
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Content="{loc:Tr SourceFiles.AddFiles}" Click="OnAddVideoFilesClick" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" FontSize="11" Padding="10,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="{loc:Tr SourceFiles.MeasureSizes}" Command="{Binding AnalyzePlanetSizesCommand}" FontSize="11" Padding="8,5" ToolTip.Tip="{loc:Tr SourceFiles.MeasureSizesTip}"/>
                </Grid>

                <!-- Rangée 2 : Actions groupées (Tri, Réorganisation, Nettoyage) -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Groupe Tri -->
                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="{loc:Tr SourceFiles.SortAsc}" Command="{Binding SortFilesBySizeAscendingCommand}" FontSize="10" Padding="5,3" ToolTip.Tip="{loc:Tr SourceFiles.SortAscTip}"/>
                            <Button Content="{loc:Tr SourceFiles.SortDesc}" Command="{Binding SortFilesBySizeDescendingCommand}" FontSize="10" Padding="5,3" ToolTip.Tip="{loc:Tr SourceFiles.SortDescTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Groupe Réorganisation (Monter / Descendre) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="4,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="▲" Command="{Binding MoveSelectedFileUpCommand}" FontSize="11" Padding="8,3" ToolTip.Tip="{loc:Tr SourceFiles.MoveUpTip}"/>
                            <Button Content="▼" Command="{Binding MoveSelectedFileDownCommand}" FontSize="11" Padding="8,3" ToolTip.Tip="{loc:Tr SourceFiles.MoveDownTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Groupe Suppression (Suppr / Vider) -->
                    <Border Grid.Column="2" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="🗑" Command="{Binding RemoveSelectedFileCommand}" FontSize="11" Padding="6,3" ToolTip.Tip="{loc:Tr SourceFiles.DeleteSelectionTip}"/>
                            <Button Content="✕" Command="{Binding ClearAllFilesCommand}" FontSize="11" Padding="6,3" ToolTip.Tip="{loc:Tr SourceFiles.ClearList}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tableau / Cartes des fichiers sources -->
        <Border Grid.Row="1" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="140" Margin="0,0,0,4">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource AppTableHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="☑" Command="{Binding ToggleCheckAllFilesCommand}" Padding="4,1" FontSize="11" Background="Transparent" ToolTip.Tip="{loc:Tr SourceFiles.CheckAllTip}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr SourceFiles.ColFileName}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SourceFiles.Count, StringFormat='{}{0} item(s)'}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" PointerPressed="OnFileListPointerPressed" PointerMoved="OnFileListPointerMoved" PointerReleased="OnFileListPointerReleased" ItemsSource="{Binding SourceFiles}" SelectedItem="{Binding SelectedSourceFile}" Background="Transparent" BorderThickness="0" Padding="3">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedFileCommand}"/>
                        <KeyBinding Gesture="Alt+Up" Command="{Binding MoveSelectedFileUpCommand}"/>
                        <KeyBinding Gesture="Alt+Down" Command="{Binding MoveSelectedFileDownCommand}"/>
                    </ListBox.KeyBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceFileItem">
                            <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2">
                                <Grid RowDefinitions="Auto,Auto">
                                    <!-- Ligne 1 : Checkbox + Nom du fichier + FormatBadge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}"/>
                                        </Border>
                                    </Grid>
                                    <!-- Ligne 2 : Frames • Taille • Résolution • Diamètre -->
                                    <WrapPanel Grid.Row="1" Margin="24,3,0,0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Frames, StringFormat='{}{0} fr'}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding PlanetSizeText, StringFormat='{}⌀ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppBadgeAccent}"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Bas du volet gauche : Options de session & Presets ULTRA-COMPACT SANS SCROLLBAR -->
        <Border Grid.Row="2" Classes="groupbox" Padding="6,6">
            <StackPanel Spacing="5">
                <!-- Ligne 1 : Mode (Batch / Join) + Sélecteur de Preset -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <RadioButton Content="{loc:Tr SourceFiles.BatchMode}" IsChecked="{Binding IsBatchMode}" FontSize="11" VerticalAlignment="Center"/>
                        <RadioButton Content="{loc:Tr SourceFiles.JoinMode}" IsChecked="{Binding IsJoinMode}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" SelectedIndex="{Binding SelectedPresetIndex}" FontSize="11" Padding="6,3" MinWidth="110" ToolTip.Tip="{loc:Tr SourceFiles.PresetsTitle}">
                        <ComboBoxItem Content="{loc:Tr SourceFiles.PresetManual}"/>
                        <ComboBoxItem Content="{loc:Tr SourceFiles.PresetPlanetary}"/>
                        <ComboBoxItem Content="{loc:Tr SourceFiles.PresetSolarLunarCloseup}"/>
                        <ComboBoxItem Content="{loc:Tr SourceFiles.PresetSolarLunarFullDisc}"/>
                        <ComboBoxItem Content="{loc:Tr SourceFiles.PresetIss}"/>
                        <ComboBoxItem Content="{loc:Tr SourceFiles.PresetPlanetaryAnimation}"/>
                    </ComboBox>
                </Grid>

                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,1"/>

                <!-- Ligne 2 : Plage de trames compacte (De ... à ...) -->
                <Grid ColumnDefinitions="Auto,*,Auto,*" VerticalAlignment="Center">
                    <CheckBox Grid.Column="0" Content="{loc:Tr SourceFiles.LimitRange}" IsChecked="{Binding LimitFrameRange}" FontSize="11" Margin="0,0,6,0"/>
                    <controls:NumberStepper Grid.Column="1" Value="{Binding StartFrame}" Minimum="1" Maximum="999999" FormatString="0" IsEnabled="{Binding LimitFrameRange}" MinWidth="50"/>
                    <TextBlock Grid.Column="2" Text="➔" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center" Margin="6,0"/>
                    <controls:NumberStepper Grid.Column="3" Value="{Binding EndFrame}" Minimum="1" Maximum="999999" FormatString="0" IsEnabled="{Binding LimitFrameRange}" MinWidth="50"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
