<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.SourceFilesView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*,Auto" Margin="4,8,4,4">

            <!-- Barre d'outils de la liste des fichiers -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                <TextBlock Text="{loc:Tr SourceFiles.Header}" Classes="grouptitle" VerticalAlignment="Center" Margin="0"/>
                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.AddFiles}" Click="OnAddVideoFilesClick" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="10,4"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.MeasureSizes}" Command="{Binding AnalyzePlanetSizesCommand}" FontSize="12" Padding="8,4" ToolTip.Tip="{loc:Tr SourceFiles.MeasureSizesTip}"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.SortAsc}" Command="{Binding SortFilesBySizeAscendingCommand}" FontSize="12" Padding="8,4" ToolTip.Tip="{loc:Tr SourceFiles.SortAscTip}"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.SortDesc}" Command="{Binding SortFilesBySizeDescendingCommand}" FontSize="12" Padding="8,4" ToolTip.Tip="{loc:Tr SourceFiles.SortDescTip}"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.MoveUp}" Command="{Binding MoveSelectedFileUpCommand}" FontSize="12" Padding="8,4" ToolTip.Tip="{loc:Tr SourceFiles.MoveUpTip}"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.MoveDown}" Command="{Binding MoveSelectedFileDownCommand}" FontSize="12" Padding="8,4" ToolTip.Tip="{loc:Tr SourceFiles.MoveDownTip}"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.DeleteSelection}" Command="{Binding RemoveSelectedFileCommand}" FontSize="12" Padding="8,4" ToolTip.Tip="{loc:Tr SourceFiles.DeleteSelectionTip}"/>
                    <Button Margin="0,0,6,4" Content="{loc:Tr SourceFiles.ClearList}" Command="{Binding ClearAllFilesCommand}" FontSize="12" Padding="8,4"/>
                </WrapPanel>
            </Grid>

            <!-- Tableau des fichiers sources -->
            <Border Grid.Row="1" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="140" Margin="0,0,0,10">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource AppTableHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid ColumnDefinitions="32,3*,1.4*,0.8*,1.1*,0.9*,0.9*,1*">
                            <Button Grid.Column="0" Content="☑" Command="{Binding ToggleCheckAllFilesCommand}" Padding="2,0" FontSize="12" Background="Transparent" ToolTip.Tip="{loc:Tr SourceFiles.CheckAllTip}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr SourceFiles.ColFileName}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr SourceFiles.ColType}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="{loc:Tr SourceFiles.ColFrames}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="{loc:Tr SourceFiles.ColDimensions}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="5" Text="{loc:Tr SourceFiles.ColFps}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="6" Text="{loc:Tr SourceFiles.ColSize}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="{loc:Tr SourceFiles.ColDiameter}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" ToolTip.Tip="{loc:Tr SourceFiles.ColDiameterTip}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" PointerPressed="OnFileListPointerPressed" PointerMoved="OnFileListPointerMoved" PointerReleased="OnFileListPointerReleased" ItemsSource="{Binding SourceFiles}" SelectedItem="{Binding SelectedSourceFile}" Background="Transparent" BorderThickness="0">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedFileCommand}"/>
                            <KeyBinding Gesture="Alt+Up" Command="{Binding MoveSelectedFileUpCommand}"/>
                            <KeyBinding Gesture="Alt+Down" Command="{Binding MoveSelectedFileDownCommand}"/>
                        </ListBox.KeyBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceFileItem">
                                <Grid ColumnDefinitions="32,3*,1.4*,0.8*,1.1*,0.9*,0.9*,1*" Margin="4,2">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FormatBadge}" FontSize="12" Foreground="{DynamicResource AppBadgeFormat}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Frames}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Resolution}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding FpsInfo}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding FileSize}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="{Binding PlanetSizeText}" FontSize="12" Foreground="{DynamicResource AppBadgeAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Bas de l'onglet 1 : Mode Batch/Join à gauche + "Optimise Options For" à droite -->
            <Grid Grid.Row="2" ColumnDefinitions="*,10,*">
                <Border Grid.Column="0" Classes="groupbox">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr SourceFiles.ModeTitle}" Classes="grouptitle"/>
                        <RadioButton Content="{loc:Tr SourceFiles.BatchMode}" IsChecked="{Binding IsBatchMode}" FontSize="12"/>
                        <RadioButton Content="{loc:Tr SourceFiles.JoinMode}" IsChecked="{Binding IsJoinMode}" FontSize="12"/>
                        <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,4"/>
                        <CheckBox Content="{loc:Tr SourceFiles.LimitRange}" IsChecked="{Binding LimitFrameRange}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding LimitFrameRange}">
                            <TextBlock Text="{loc:Tr SourceFiles.Start}" Classes="label"/>
                            <controls:NumberStepper Value="{Binding StartFrame}" Minimum="1" Maximum="999999" FormatString="0" Width="120"/>
                            <TextBlock Text="{loc:Tr SourceFiles.End}" Classes="label"/>
                            <controls:NumberStepper Value="{Binding EndFrame}" Minimum="1" Maximum="999999" FormatString="0" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="groupbox">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr SourceFiles.PresetsTitle}" Classes="grouptitle"/>
                        <TextBlock Text="{loc:Tr SourceFiles.PresetsSubtitle}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" Margin="0,0,0,2"/>
                        <ComboBox SelectedIndex="{Binding SelectedPresetIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetManual}"/>
                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetPlanetary}"/>
                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetSolarLunarCloseup}"/>
                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetSolarLunarFullDisc}"/>
                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetIss}"/>
                            <ComboBoxItem Content="{loc:Tr SourceFiles.PresetPlanetaryAnimation}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
