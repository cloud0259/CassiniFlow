<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:conv="using:CassiniFlow.Desktop.Converters"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.SourceFilesView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="2">

        <!-- Barre d'outils structurée en 2 rangées professionnelles -->
        <Border Grid.Row="0" Classes="groupbox" Padding="6,5" Margin="0,0,0,4" IsEnabled="{Binding !IsFileListBusy}">
            <StackPanel Spacing="5">
                <!-- Rangée 1 : Actions principales (Ajouter & Mesurer & Calibration) -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="0" Content="{loc:Tr SourceFiles.AddFiles}" Click="OnAddVideoFilesClick" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" FontSize="11" Padding="10,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="{loc:Tr SourceFiles.AddCalibration}" FontSize="11" Padding="8,5" Margin="0,0,4,0">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{loc:Tr SourceFiles.AddDarks}" Click="OnAddDarkFilesClick"/>
                                <MenuItem Header="{loc:Tr SourceFiles.AddFlats}" Click="OnAddFlatFilesClick"/>
                                <MenuItem Header="{loc:Tr SourceFiles.AddFlatDarks}" Click="OnAddFlatDarkFilesClick"/>
                                <MenuItem Header="-"/>
                                <MenuItem Header="{loc:Tr SourceFiles.ClearCalibration}" Command="{Binding ClearAllCalibrationFilesCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Content="{loc:Tr SourceFiles.MeasureSizes}" Command="{Binding AnalyzePlanetSizesCommand}" FontSize="11" Padding="8,5" ToolTip.Tip="{loc:Tr SourceFiles.MeasureSizesTip}"/>
                </Grid>

                <!-- Rangée 2 : Actions groupées (Tri, Réorganisation, Nettoyage) -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Groupe Tri -->
                    <Border Grid.Column="0" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="{loc:Tr SourceFiles.SortAsc}" Command="{Binding SortFilesBySizeAscendingCommand}" FontSize="10" Padding="5,3" ToolTip.Tip="{loc:Tr SourceFiles.SortAscTip}"/>
                            <Button Content="{loc:Tr SourceFiles.SortDesc}" Command="{Binding SortFilesBySizeDescendingCommand}" FontSize="10" Padding="5,3" ToolTip.Tip="{loc:Tr SourceFiles.SortDescTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Groupe Réorganisation (Monter / Descendre) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="4,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="▲" Command="{Binding MoveSelectedFileUpCommand}" FontSize="11" Padding="8,3" ToolTip.Tip="{loc:Tr SourceFiles.MoveUpTip}"/>
                            <Button Content="▼" Command="{Binding MoveSelectedFileDownCommand}" FontSize="11" Padding="8,3" ToolTip.Tip="{loc:Tr SourceFiles.MoveDownTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Groupe Suppression (Suppr / Vider) -->
                    <Border Grid.Column="2" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="🗑" Command="{Binding RemoveSelectedFileCommand}" FontSize="11" Padding="6,3" ToolTip.Tip="{loc:Tr SourceFiles.DeleteSelectionTip}"/>
                            <Button Content="✕" Command="{Binding ClearAllFilesCommand}" FontSize="11" Padding="6,3" ToolTip.Tip="{loc:Tr SourceFiles.ClearList}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bandeau récapitulatif Calibration (Darks, Flats, Flat-Darks) -->
                <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2,0,0" IsVisible="{Binding HasCalibrationFiles}">
                    <Grid ColumnDefinitions="*,Auto">
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Badge Darks -->
                            <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="3" Padding="4,2" Margin="0,0,4,0" IsVisible="{Binding DarkFiles.Count}" ToolTip.Tip="{Binding DarkFilesTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="🌑" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DarkCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                    <Button Content="✕" Command="{Binding ClearDarkFilesCommand}" FontSize="8" Padding="2,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}"/>
                                </StackPanel>
                            </Border>

                            <!-- Badge Flats -->
                            <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="3" Padding="4,2" Margin="0,0,4,0" IsVisible="{Binding FlatFiles.Count}" ToolTip.Tip="{Binding FlatFilesTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="⚪" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FlatCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppBadgeAccent}" VerticalAlignment="Center"/>
                                    <Button Content="✕" Command="{Binding ClearFlatFilesCommand}" FontSize="8" Padding="2,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}"/>
                                </StackPanel>
                            </Border>

                            <!-- Badge Flat-Darks -->
                            <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="3" Padding="4,2" Margin="0,0,4,0" IsVisible="{Binding FlatDarkFiles.Count}" ToolTip.Tip="{Binding FlatDarkFilesTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="🌗" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FlatDarkCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppBadgeFormat}" VerticalAlignment="Center"/>
                                    <Button Content="✕" Command="{Binding ClearFlatDarkFilesCommand}" FontSize="8" Padding="2,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Tout effacer -->
                        <Button Grid.Column="1" Content="✕" Command="{Binding ClearAllCalibrationFilesCommand}" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}" FontSize="9" Padding="4,2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tableau / Cartes des fichiers sources et de calibration via onglets -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedSourceFileTabIndex, Mode=TwoWay}"
                    Padding="0"
                    Margin="0,0,0,4">

            <!-- Onglet 1 : Brutes / Lights -->
            <TabItem Padding="6,4" FontSize="11">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Tr SourceFiles.TabLights}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="8" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding SourceFiles.Count}">
                            <TextBlock Text="{Binding SourceFiles.Count}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppAccent}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="140">
                    <Grid RowDefinitions="Auto,*" DragDrop.AllowDrop="True" DragDrop.DragOver="OnCalibrationDragOver" DragDrop.Drop="OnLightsDrop">
                        <Border Grid.Row="0" Background="{DynamicResource AppTableHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding AreAllFilesChecked, Mode=TwoWay}" IsThreeState="True" MinWidth="0" VerticalAlignment="Center" Margin="0,0,0,0" ToolTip.Tip="{loc:Tr SourceFiles.CheckAllTip}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr SourceFiles.ColFileName}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding SourceFiles.Count, StringFormat='{}{0} item(s)'}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" PointerPressed="OnFileListPointerPressed" PointerMoved="OnFileListPointerMoved" PointerReleased="OnFileListPointerReleased" ItemsSource="{Binding SourceFiles}" SelectedItem="{Binding SelectedSourceFile}" Background="Transparent" BorderThickness="0" Padding="3">
                            <ListBox.KeyBindings>
                                <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedFileCommand}"/>
                                <KeyBinding Gesture="Alt+Up" Command="{Binding MoveSelectedFileUpCommand}"/>
                                <KeyBinding Gesture="Alt+Down" Command="{Binding MoveSelectedFileDownCommand}"/>
                            </ListBox.KeyBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SourceFileItem">
                                    <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <!-- Ligne 1 : Checkbox + Nom du fichier + FormatBadge -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <!-- Ligne 2 : Frames • Taille • Résolution • Diamètre • Expo/Gain -->
                                            <WrapPanel Grid.Row="1" Margin="24,3,0,0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Frames, StringFormat='{}{0} fr'}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding PlanetSizeText, StringFormat='{}⌀ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppBadgeAccent}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding IdentifiedObjectBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}" Margin="0,0,8,0" IsVisible="{Binding HasIdentifiedObject}"/>
                                                <TextBlock Text="{Binding ExposureInfo, StringFormat='{}⏱ {0}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,8,0" IsVisible="{Binding HasAstroDetails}"/>
                                                <TextBlock Text="{Binding IsoOrGainInfo}" FontSize="11" Foreground="{DynamicResource AppBadgeFormat}" IsVisible="{Binding HasAstroDetails}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Overlay de chargement -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#E00B1120"
                                IsVisible="{Binding IsFileListBusy}"
                                CornerRadius="4"
                                ZIndex="100">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="20">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220" Height="6"/>
                                <TextBlock Text="{Binding BusyStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccent}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Onglet 2 : Darks -->
            <TabItem Padding="6,4" FontSize="11">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🌑" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr SourceFiles.TabDarks}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="8" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding DarkFiles.Count}">
                            <TextBlock Text="{Binding DarkFiles.Count}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppAccent}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="140">
                    <Grid RowDefinitions="Auto,*" DragDrop.AllowDrop="True" DragDrop.DragOver="OnCalibrationDragOver" DragDrop.Drop="OnDarksDrop">
                        <!-- Barre d'actions spécifique Darks -->
                        <Border Grid.Row="0" Background="{DynamicResource AppTableHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="{loc:Tr SourceFiles.AddDarks}" Click="OnAddDarkFilesClick" FontSize="11" Padding="8,3"/>
                                <TextBlock Grid.Column="1" Text="{Binding DarkCountText}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="✕" Command="{Binding ClearDarkFilesCommand}" IsEnabled="{Binding DarkFiles.Count}" FontSize="10" Padding="5,2" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}"/>
                            </Grid>
                        </Border>

                        <!-- Liste des fichiers Dark -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding DarkFiles}" Background="Transparent" BorderThickness="0" Padding="3">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2" ToolTip.Tip="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Converter={x:Static conv:FileNameConverter.Instance}}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Converter={x:Static conv:FileSizeConverter.Instance}}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppBadgeBackground}" CornerRadius="3" Padding="4,2" Margin="4,0">
                                                <TextBlock Text="DARK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppAccent}"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="✕" Click="OnRemoveDarkFileClick" FontSize="10" Padding="4,2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr SourceFiles.DeleteSelectionTip}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" IsVisible="{Binding !DarkFiles.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="🌑" FontSize="24" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="{loc:Tr SourceFiles.DarksEmptyPrompt}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Onglet 3 : Flats -->
            <TabItem Padding="6,4" FontSize="11">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="⚪" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr SourceFiles.TabFlats}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="8" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding FlatFiles.Count}">
                            <TextBlock Text="{Binding FlatFiles.Count}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppBadgeAccent}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="140">
                    <Grid RowDefinitions="Auto,*" DragDrop.AllowDrop="True" DragDrop.DragOver="OnCalibrationDragOver" DragDrop.Drop="OnFlatsDrop">
                        <!-- Barre d'actions spécifique Flats -->
                        <Border Grid.Row="0" Background="{DynamicResource AppTableHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="{loc:Tr SourceFiles.AddFlats}" Click="OnAddFlatFilesClick" FontSize="11" Padding="8,3"/>
                                <TextBlock Grid.Column="1" Text="{Binding FlatCountText}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="✕" Command="{Binding ClearFlatFilesCommand}" IsEnabled="{Binding FlatFiles.Count}" FontSize="10" Padding="5,2" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}"/>
                            </Grid>
                        </Border>

                        <!-- Liste des fichiers Flat -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding FlatFiles}" Background="Transparent" BorderThickness="0" Padding="3">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2" ToolTip.Tip="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Converter={x:Static conv:FileNameConverter.Instance}}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Converter={x:Static conv:FileSizeConverter.Instance}}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppBadgeBackground}" CornerRadius="3" Padding="4,2" Margin="4,0">
                                                <TextBlock Text="FLAT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppBadgeAccent}"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="✕" Click="OnRemoveFlatFileClick" FontSize="10" Padding="4,2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr SourceFiles.DeleteSelectionTip}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" IsVisible="{Binding !FlatFiles.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="⚪" FontSize="24" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="{loc:Tr SourceFiles.FlatsEmptyPrompt}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Onglet 4 : Flat-Darks -->
            <TabItem Padding="6,4" FontSize="11">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🌗" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr SourceFiles.TabFlatDarks}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AppBadgeBackground}" CornerRadius="8" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding FlatDarkFiles.Count}">
                            <TextBlock Text="{Binding FlatDarkFiles.Count}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="140">
                    <Grid RowDefinitions="Auto,*" DragDrop.AllowDrop="True" DragDrop.DragOver="OnCalibrationDragOver" DragDrop.Drop="OnFlatDarksDrop">
                        <!-- Barre d'actions spécifique Flat-Darks -->
                        <Border Grid.Row="0" Background="{DynamicResource AppTableHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="{loc:Tr SourceFiles.AddFlatDarks}" Click="OnAddFlatDarkFilesClick" FontSize="11" Padding="8,3"/>
                                <TextBlock Grid.Column="1" Text="{Binding FlatDarkCountText}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="✕" Command="{Binding ClearFlatDarkFilesCommand}" IsEnabled="{Binding FlatDarkFiles.Count}" FontSize="10" Padding="5,2" ToolTip.Tip="{loc:Tr SourceFiles.ClearCalibration}"/>
                            </Grid>
                        </Border>

                        <!-- Liste des fichiers Flat-Dark -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding FlatDarkFiles}" Background="Transparent" BorderThickness="0" Padding="3">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2" ToolTip.Tip="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Converter={x:Static conv:FileNameConverter.Instance}}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Converter={x:Static conv:FileSizeConverter.Instance}}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource AppBadgeBackground}" CornerRadius="3" Padding="4,2" Margin="4,0">
                                                <TextBlock Text="FLAT-DARK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="✕" Click="OnRemoveFlatDarkFileClick" FontSize="10" Padding="4,2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr SourceFiles.DeleteSelectionTip}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" IsVisible="{Binding !FlatDarkFiles.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" IsHitTestVisible="False">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="🌗" FontSize="24" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="{loc:Tr SourceFiles.FlatDarksEmptyPrompt}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bas du volet gauche : Inspecteur de Métadonnées du fichier sélectionné -->
        <Border Grid.Row="2" Classes="groupbox" Padding="8,6">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{loc:Tr Metadata.Title}" Classes="grouptitle" Margin="0"/>
                    <Border VerticalAlignment="Center" Background="{DynamicResource AppPanelSubtleBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" IsVisible="{Binding SelectedSourceFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding SelectedSourceFile.FormatBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppBadgeFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Détails quand un fichier est sélectionné -->
                <StackPanel Spacing="3" IsVisible="{Binding SelectedSourceFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding SelectedSourceFile.FileName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Dim}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.Resolution}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Frames}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.Frames}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Size}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.FileSize}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Fps}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.FpsInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Exp}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.ExposureInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Speed}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.ShutterSpeedInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.GainIso}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.IsoOrGainInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Diameter}" FontSize="11" Foreground="{DynamicResource AppBadgeAccent}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedSourceFile.PlanetSizeText}" FontSize="11" Foreground="{DynamicResource AppBadgeAccent}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding SelectedSourceFile.HasIdentifiedObject}">
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SelectedSourceFile.IdentifiedObjectSummary, StringFormat='Objet : {0}'}" FontSize="11" Foreground="{DynamicResource AppAccent}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding SelectedSourceFile.HasCameraInfo}">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{loc:Tr Metadata.Camera}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.CameraInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding SelectedSourceFile.HasTelescopeInfo}">
                            <TextBlock Text="{loc:Tr Metadata.Optics}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SelectedSourceFile.TelescopeInfo}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Message quand aucun fichier n'est sélectionné -->
                <TextBlock Text="{loc:Tr Metadata.NoSelectionPrompt}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" FontStyle="Italic" IsVisible="{Binding SelectedSourceFile, Converter={x:Static ObjectConverters.IsNull}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
