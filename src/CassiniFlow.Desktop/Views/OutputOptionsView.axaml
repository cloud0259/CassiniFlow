<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.OutputOptionsView"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Spacing="10" Margin="2,4,2,2">
        <Border Classes="groupbox" Padding="10,8">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr OutputOptions.FormatTitle}" Classes="grouptitle"/>
                <ComboBox SelectedIndex="{Binding SelectedOutputFormatIndex}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatAvi}"/>
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatMp4}"/>
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatSer}"/>
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatBmp}"/>
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatPng}"/>
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatTiff}"/>
                    <ComboBoxItem Content="{loc:Tr OutputOptions.FormatFits}"/>
                </ComboBox>

                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,2"/>

                <CheckBox Content="{loc:Tr OutputOptions.KeepFps}" IsChecked="{Binding MatchInputFps}" FontSize="12"/>
                <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !MatchInputFps}">
                    <TextBlock Grid.Column="0" Text="{loc:Tr OutputOptions.CustomFps}" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <controls:NumberStepper Grid.Column="1" Value="{Binding OutputFps}" Minimum="1" Maximum="240" FormatString="0" Width="110"/>
                </Grid>

                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,2"/>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr OutputOptions.FileSuffix}" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputSuffix}" Width="110"/>
                </Grid>
                <CheckBox Content="{loc:Tr OutputOptions.WinJuposNaming}" IsChecked="{Binding WinJuposNaming}" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Classes="groupbox" Padding="10,8">
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr OutputOptions.DestinationFolder}" Classes="grouptitle"/>
                <TextBlock Text="{loc:Tr OutputOptions.DefaultFolderHint}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" TextWrapping="Wrap"/>
                <TextBox Text="{Binding CustomOutputDirectory}" Watermark="{loc:Tr OutputOptions.FolderWatermark}" Margin="0,2"/>
                <Grid ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0" Content="{loc:Tr OutputOptions.Browse}" Click="OnSelectOutputFolderClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="{loc:Tr OutputOptions.OpenFolder}" Command="{Binding OpenOutputFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
