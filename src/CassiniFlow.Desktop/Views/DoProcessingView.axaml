<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.DoProcessingView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,*" Margin="4,8,4,4">

            <Border Grid.Row="0" Classes="groupbox" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr DoProcessing.ExecutionTitle}" Classes="grouptitle" Margin="0"/>
                        <TextBlock Text="{Binding ProcessingStageText}" FontSize="13" Foreground="{DynamicResource AppBadgeFormat}"/>
                        <TextBlock Text="{Binding SummaryStatsText}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{loc:Tr DoProcessing.StartProcessing}" Command="{Binding RunProcessingCommand}" IsEnabled="{Binding !IsProcessing}" Background="{DynamicResource AppAccent}" Foreground="White" FontWeight="SemiBold" Padding="16,8"/>
                        <Button Content="{loc:Tr DoProcessing.Cancel}" Command="{Binding CancelProcessingCommand}" IsEnabled="{Binding IsProcessing}" Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="groupbox" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}" Height="14"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasCompletedOutput}">
                        <Button Content="{loc:Tr DoProcessing.PlayGenerated}" Command="{Binding PlayLastOutputVideoCommand}" Background="#16a34a" Foreground="White" FontWeight="SemiBold" Padding="12,6"/>
                        <Button Content="{loc:Tr DoProcessing.OpenOutput}" Command="{Binding OpenOutputFolderCommand}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="groupbox" MinHeight="160">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{loc:Tr DoProcessing.ExecutionLog}" Classes="grouptitle"/>
                    <TextBox Grid.Row="1" Text="{Binding ConsoleLogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Monospace" FontSize="12" Background="{DynamicResource AppConsoleLogBg}" Foreground="{DynamicResource AppTextPrimary}"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
