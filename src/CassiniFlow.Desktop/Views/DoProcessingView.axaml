<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.DoProcessingView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,*" Margin="4,8,4,4">

            <Border Grid.Row="0" Classes="groupbox" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr DoProcessing.ExecutionTitle}" Classes="grouptitle" Margin="0"/>
                            <TextBlock Text="{Binding ProcessingStageText}" FontSize="13" Foreground="{DynamicResource AppBadgeFormat}"/>
                            <TextBlock Text="{Binding SummaryStatsText}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="{loc:Tr DoProcessing.StartProcessing}"
                                    Command="{Binding RunProcessingCommand}"
                                    IsVisible="{Binding !IsProcessing}"
                                    IsEnabled="{Binding CanStartProcessing}"
                                    ToolTip.Tip="{Binding StartProcessingValidationMessage}"
                                    Background="{DynamicResource AppAccent}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="16,8"/>
                            <Button IsVisible="{Binding IsProcessing}" IsEnabled="False" Background="{DynamicResource AppAccent}" Foreground="White" Padding="20,8" ToolTip.Tip="{loc:Tr Toolbar.ProcessingInProgress}" MinWidth="110" HorizontalContentAlignment="Center">
                                <controls:EllipsisBounceLoader DotBrush="White" DotSize="7"/>
                            </Button>
                            <Button Content="{loc:Tr DoProcessing.Cancel}" Command="{Binding CancelProcessingCommand}" IsVisible="{Binding IsProcessing}" Classes="secondary-cancel" Padding="14,8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Message explicite si le bouton Démarrer est bloqué -->
                    <Border Background="#2a1515" BorderBrush="#dc2626" BorderThickness="1" CornerRadius="4" Padding="8,5"
                            IsVisible="{Binding HasStartValidationIssue}">
                        <TextBlock Text="{Binding StartProcessingValidationMessage}" FontSize="11.5" Foreground="#fca5a5" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Carte d'erreur explicite lors de l'exécution -->
                    <Border Background="#2a1212" BorderBrush="#dc2626" BorderThickness="1" CornerRadius="4" Padding="10,8"
                            IsVisible="{Binding HasActiveError}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center"/>
                                    <Border Background="#dc2626" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveErrorCode}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding ActiveErrorTitle}" FontSize="12.5" FontWeight="Bold" Foreground="#fca5a5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="{Binding ErrorCopyButtonText}" Command="{Binding CopyErrorDetailsCommand}"
                                            Background="#3b1d1d" Foreground="#fca5a5" BorderBrush="#ef4444" BorderThickness="1"
                                            FontSize="10.5" Padding="8,3" CornerRadius="4"/>
                                    <Button Content="✕" Command="{Binding DismissErrorCommand}"
                                            Background="Transparent" Foreground="#fca5a5" FontSize="12" Padding="4,2"
                                            ToolTip.Tip="{loc:Tr Errors.Dismiss}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ActiveErrorMessage}" FontSize="11.5" Foreground="#fecaca" TextWrapping="Wrap"/>
                            <Border Background="#1a1111" BorderBrush="#b91c1c" BorderThickness="1" CornerRadius="4" Padding="8,5"
                                    IsVisible="{Binding HasActiveErrorSuggestion}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Tr Errors.ResolutionTitle}" FontSize="10.5" FontWeight="Bold" Foreground="#fcd34d"/>
                                    <TextBlock Text="{Binding ActiveErrorSuggestion}" FontSize="11" Foreground="#fef3c7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="groupbox" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}" Height="8" CornerRadius="4"/>
                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding HasCompletedOutput}">
                        <Button Grid.Column="0"
                                Content="{Binding PlayOrOpenOutputText}"
                                Command="{Binding PlayLastOutputVideoCommand}"
                                Background="#16a34a"
                                Foreground="White"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8,8"/>
                        <Button Grid.Column="2"
                                Content="{loc:Tr DoProcessing.OpenOutput}"
                                Command="{Binding OpenOutputFolderCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8,8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="groupbox" MinHeight="180">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{loc:Tr DoProcessing.ExecutionLog}" Classes="grouptitle"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding ConsoleLogText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Height="260"
                             FontFamily="Consolas, Monospace"
                             FontSize="12"
                             Background="{DynamicResource AppConsoleLogBg}"
                             Foreground="{DynamicResource AppTextPrimary}"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
