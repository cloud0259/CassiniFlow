<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.AnimationOptionsView"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Spacing="10" Margin="2,4,2,2">
        <Border Classes="groupbox" Padding="10,8">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr AnimationOptions.PlaybackTitle}" Classes="grouptitle"/>
                <CheckBox Content="{loc:Tr AnimationOptions.ForwardPlay}" IsChecked="{Binding AnimationForward}" FontSize="12"/>
                <CheckBox Content="{loc:Tr AnimationOptions.ReversePlay}" IsChecked="{Binding AnimationReverse}" FontSize="12"/>
                
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{loc:Tr AnimationOptions.RepeatCount}" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <controls:NumberStepper Grid.Column="1" Value="{Binding AnimationRepeatCount}" Minimum="1" Maximum="50" FormatString="0" Width="110"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
