<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CassiniFlow.Desktop.ViewModels"
             xmlns:controls="using:CassiniFlow.Desktop.Controls"
             xmlns:loc="using:CassiniFlow.Desktop.Localization"
             x:Class="CassiniFlow.Desktop.Views.FrameViewerView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- En-tête de la visionneuse / Barre d'outils HUD -->
        <Border Grid.Row="0" Classes="groupbox" Padding="10,6" Margin="0,0,0,6">
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ViewerTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding FrameDimensionsText}" FontSize="12" Foreground="{DynamicResource AppBadgeFormat}" Margin="8,0,0,0"/>
                </Grid>
                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="{loc:Tr Viewer.ShowCropped}" IsChecked="{Binding PreviewCroppedOutput}" FontSize="12" Margin="0,0,14,0"/>
                    <CheckBox Content="{loc:Tr Viewer.ShowOverlay}" IsChecked="{Binding ShowOverlayBoxes}" IsEnabled="{Binding !PreviewCroppedOutput}" FontSize="12" Margin="0,0,14,0"/>
                    <CheckBox Content="{loc:Tr Viewer.ShowAlignmentGrid}" IsChecked="{Binding IsAlignmentGridVisible}" ToolTip.Tip="{loc:Tr Viewer.ShowAlignmentGridTip}" FontSize="12" Margin="0,0,14,0"/>
                    <CheckBox Content="{loc:Tr Viewer.TestThreshold}" IsChecked="{Binding ShowDetectedPixelsRed}" ToolTip.Tip="{loc:Tr Viewer.TestThresholdTip}" FontSize="12"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Canvas d'aperçu haute résolution avec fond sombre astrophysique -->
        <Border Grid.Row="1" Background="#06090E" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,6">
            <controls:AstroViewerControl />
        </Border>

        <!-- Contrôles de navigation temporelle et Graphique de Qualité / Seeing (Ticket #61) -->
        <Border Grid.Row="2" Classes="groupbox" Padding="10,6">
            <StackPanel Spacing="6">
                <!-- Barre d'outils Timeline : Modes, Navigation, Hauteur -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Bascule Mode Chrono vs Trié + Bouton Meilleure trame -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Button Content="{loc:Tr Viewer.TimelineChrono}"
                                Command="{Binding ToggleTimelineModeCommand}"
                                IsVisible="{Binding !IsTimelineChronological}"
                                Padding="8,3" FontSize="11" />
                        <Button Content="{loc:Tr Viewer.TimelineSorted}"
                                Command="{Binding ToggleTimelineModeCommand}"
                                IsVisible="{Binding IsTimelineChronological}"
                                Padding="8,3" FontSize="11" />
                        
                        <!-- Bouton Meilleure Trame -->
                        <Button Content="★ Best" Command="{Binding GoToBestFrameCommand}" Padding="6,3" FontSize="11"
                                ToolTip.Tip="Aller directement à la trame ayant le meilleur score"/>
                    </StackPanel>

                    <!-- Choix interactif des courbes actives (Gradient par défaut + Histogramme optionnel) & Seeing -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Checkbox Gradient (cyan) -->
                        <CheckBox IsChecked="{Binding TimelineShowGradient}" Margin="0" Padding="4,0,0,0" VerticalAlignment="Center"
                                  ToolTip.Tip="Afficher la courbe de netteté par gradient">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Background="#38bdf8" Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Viewer.AlgoGradient}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#38bdf8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Checkbox Histogramme (ambre) -->
                        <CheckBox IsChecked="{Binding TimelineShowPeakHisto}" Margin="4,0,0,0" Padding="4,0,0,0" VerticalAlignment="Center"
                                  ToolTip.Tip="Afficher la courbe de qualité par histogramme de crête">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Background="#fbbf24" Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"/>
                                <TextBlock Text="Histogramme" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#fbbf24" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Text="{Binding CurrentSeeingText}" FontSize="11" Foreground="{DynamicResource AppAccentColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Bouton Agrandir / Réduire Timeline (icône dynamique) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Content="{Binding TimelineExpandIcon}" Command="{Binding ToggleTimelineExpandedCommand}" Padding="8,3" FontSize="11"
                                ToolTip.Tip="{loc:Tr Viewer.ToggleTimelineSize}"/>
                    </StackPanel>
                </Grid>

                <!-- Zone Timeline avec AstroQualityTimelineControl et Loader élégant -->
                <Grid Height="{Binding TimelineHeight}">
                    <controls:AstroQualityTimelineControl
                        TimelineData="{Binding QualityTimelineData}"
                        CurrentFrameIndex="{Binding CurrentFrameIndex}"
                        MaxFrameCount="{Binding MaxFrameCount}"
                        SelectionStart="{Binding TimelineSelectionIn}"
                        SelectionEnd="{Binding TimelineSelectionOut}"
                        CutoffPercent="{Binding TimelineCutoffPercent}"
                        IsChronologicalMode="{Binding IsTimelineChronological}"
                        ShowGradientSharpness="{Binding TimelineShowGradient}"
                        ShowNinox="{Binding TimelineShowNinox}"
                        ShowPeakHistogram="{Binding TimelineShowPeakHisto}"
                        ShowTotalBrightness="{Binding TimelineShowTotalLum}"
                        IsAnalyzing="{Binding IsTimelineAnalyzing}"
                        AnalysisProgress="{Binding TimelineAnalysisProgress}"
                        HoverFrameIndex="{Binding HoverFrameIndex, Mode=TwoWay}"
                        HoverScore="{Binding HoverScore, Mode=TwoWay}"
                        HoverRank="{Binding HoverRank, Mode=TwoWay}"
                        IsHovered="{Binding IsTimelineHovered, Mode=TwoWay}" />

                    <!-- Overlay Loader visible pendant l'analyse en arrière-plan -->
                    <Border Background="#B8090d16"
                            CornerRadius="4"
                            IsVisible="{Binding IsTimelineAnalyzing}"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <ProgressBar Value="{Binding TimelineAnalysisProgress}" Minimum="0" Maximum="100"
                                             Width="180" Height="6"
                                             Foreground="#38bdf8" Background="#1e293b" />
                                <TextBlock Text="{Binding TimelineProgressPercentText}"
                                           Foreground="#38bdf8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Tr Viewer.AnalyzingQuality}" 
                                       Foreground="#94a3b8" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Ligne 1 : Barre de Transport VCR & Curseur 'Garder' centré -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="|&lt;" Command="{Binding FirstFrameCommand}" Padding="8,3" ToolTip.Tip="{loc:Tr Menu.FirstFrame}"/>
                        <Button Content="&lt;" Command="{Binding PreviousFrameCommand}" Padding="8,3"/>
                        <Button Content="{Binding PlayPauseIcon}" Command="{Binding TogglePlayCommand}" Padding="10,3" ToolTip.Tip="Lecture / Pause" FontWeight="SemiBold"/>
                        <Button Content="&gt;" Command="{Binding NextFrameCommand}" Padding="8,3"/>
                        <Button Content="&gt;|" Command="{Binding LastFrameCommand}" Padding="8,3" ToolTip.Tip="{loc:Tr Menu.LastFrame}"/>
                    </StackPanel>

                    <!-- Seuil de sélection 'Garder' centré sans aucun élément qui déborde -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Viewer.CutoffKeepBest}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                        <Slider Minimum="5" Maximum="100" Value="{Binding TimelineCutoffPercent}" Width="120" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RetainedFramesSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentColor}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Espace équilibré à droite -->
                    <Border Grid.Column="2" Width="10" />
                </Grid>

                <!-- Ligne 2 : Statut HUD aéré (Image & Rang à gauche, Capteur au centre, Score Qualité à droite) -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr UI.FrameLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock Text="{Binding CurrentFrameIndex}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="/" FontSize="11" Foreground="{DynamicResource AppTextDimmed}"/>
                        <TextBlock Text="{Binding MaxFrameCount}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource AppTextDimmed}" Margin="4,0"/>
                        <TextBlock Text="{Binding CurrentFrameRankText}" FontSize="11" Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding MaxPixelStatsText}" FontSize="11" Foreground="{DynamicResource AppTextDimmed}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>

                    <TextBlock Grid.Column="2" Text="{Binding QualityScoreText}" FontSize="11" Foreground="#22c55e" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
