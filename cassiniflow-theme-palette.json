        "windowBackground": "#0F141C",
        "panelBackground": "#18202C",
        "panelSubtleBackground": "#121822",
        "tableHeaderBackground": "#1E2736",
        "borderColor": "#2A374A",
        "textPrimary": "#F1F5F9",
        "textSecondary": "#94A3B8",
        "textDimmed": "#64748B",
        "accentPrimary": "#2563EB",
        "accentHover": "#1D4ED8",
        "accentGlow": "rgba(37, 99, 235, 0.3)",
        "badgeFormat": "#38BDF8",
        "badgeAccent": "#FBBF24",
        "statusSuccess": "#10B981",
        "previewBackground": "#06090E"
      }
    },

    "cleanLabLight": {
      "name": "Clean Lab (Light)",
      "description": "Thème clair pour le dépouillement en bureau, cours et salles lumineuses.",
      "colors": {
        "windowBackground": "#F1F5F9",
        "panelBackground": "#FFFFFF",
        "panelSubtleBackground": "#F8FAFC",
        "tableHeaderBackground": "#E2E8F0",
        "borderColor": "#CBD5E1",
        "textPrimary": "#0F172A",
        "textSecondary": "#475569",
        "textDimmed": "#94A3B8",
        "accentPrimary": "#2563EB",
        "accentHover": "#1D4ED8",
        "accentGlow": "rgba(37, 99, 235, 0.15)",
        "badgeFormat": "#0284C7",
        "badgeAccent": "#D97706",
        "statusSuccess": "#059669",
        "previewBackground": "#1E293B"
