    "nightVisionRed": {
      "name": "Night Vision (Rouge Astro)",
      "description": "Thème terrain au télescope préservant l'adaptation nocturne de la rétine.",
      "colors": {
        "windowBackground": "#0A0202",
        "panelBackground": "#170505",
        "panelSubtleBackground": "#0F0303",
        "tableHeaderBackground": "#260909",
        "borderColor": "#4A1010",
        "textPrimary": "#FCA5A5",
        "textSecondary": "#B91C1C",
        "textDimmed": "#7F1D1D",
        "accentPrimary": "#DC2626",
        "accentHover": "#B91C1C",
        "accentGlow": "rgba(220, 38, 38, 0.4)",
