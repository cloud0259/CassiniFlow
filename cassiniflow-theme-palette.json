  "logoPalettes": {
    "cassiniOrbit": {
      "name": "Cassini Orbit (Signature)",
      "description": "Palette signature associant le bleu spatial, l'anneau cyan et l'éclat ambré de Saturne/Titan.",
      "colors": {
        "spaceBackground": "#0B0F19",
        "primaryBody": "#2563EB",
        "ringFlow": "#38BDF8",
        "saturnGlow": "#F59E0B",
        "stellarWhite": "#F8FAFC"
      }
    },

    "cosmicNebula": {
      "name": "Cosmic Nebula (Gradient)",
      "description": "Idéal pour un logo avec dégradé continu évoquant le traitement d'ondes et de flux (Flow).",
      "colors": {
        "darkBase": "#0F172A",
        "gradientStart": "#7C3AED",
        "gradientMiddle": "#2563EB",
        "gradientEnd": "#06B6D4",
        "highlight": "#FFFFFF"
      }
    },

    "redShift": {
      "name": "Red Shift (Monochrome Astro)",
      "description": "Déclinaison rouge rubis pour le badge officiel et l'intégration en mode Night Vision.",
      "colors": {
        "darkBase": "#0A0202",
        "deepShadow": "#7F1D1D",
        "primaryBody": "#DC2626",
        "ringGlow": "#F87171",
        "focalPoint": "#FEE2E2"
